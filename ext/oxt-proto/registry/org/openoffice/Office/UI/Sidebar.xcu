<?xml version="1.0" encoding="UTF-8"?>
<!-- Declares the Cowork sidebar Deck + Panel.
     Three identifiers must agree exactly across three files, or the deck
     silently never appears (the classic failure):
       1. this Panel's ImplementationURL middle segment  -> CoworkSidebar
       2. Factories.xcu <Name>                            -> CoworkSidebar
       3. Factories.xcu <FactoryImplementation>           -> the IMPL_NAME
                                                             registered in
                                                             cowork_sidebar.py
     ContextList tokens confirmed against LibreOffice core: the Writer token is
     'WriterVariants', NOT 'Writer'/'WriterDocument'. -->
<oor:component-data oor:name="Sidebar" oor:package="org.openoffice.Office.UI"
    xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <node oor:name="Content">

    <node oor:name="DeckList">
      <node oor:name="CoworkDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value xml:lang="en-US">Cowork</value>
        </prop>
        <prop oor:name="Id" oor:type="xs:string"><value>CoworkDeck</value></prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">WriterVariants, any, visible ; Calc, any, visible ; Impress, any, visible ; Draw, any, visible ;</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
      </node>
    </node>

    <node oor:name="PanelList">
      <node oor:name="CoworkPanel" oor:op="replace">
        <!-- No Title on purpose. The deck tab already says "Cowork", and a panel
             title renders as a second, collapsible header saying the same word
             for no benefit. The schema template (ToolPanel in main.xcd) carries
             no Title, so omitting it is supported. -->
        <prop oor:name="Id" oor:type="xs:string"><value>CoworkPanel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>CoworkDeck</value></prop>
        <prop oor:name="ContextList">
          <value oor:separator=";">WriterVariants, any, visible ; Calc, any, visible ; Impress, any, visible ; Draw, any, visible ;</value>
        </prop>
        <!-- middle segment 'CoworkSidebar' MUST equal Factories.xcu <Name> -->
        <prop oor:name="ImplementationURL" oor:type="xs:string">
          <value>private:resource/toolpanel/CoworkSidebar/CoworkPanel</value>
        </prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
      </node>
    </node>

  </node>
</oor:component-data>
